{
  "name": "@fsw/gestao",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "find .next -mindepth 1 -maxdepth 1 ! -name 'cache' -exec rm -rf {} + && next build && mkdir -p .next/standalone/apps/gestao/.next && cp -r .next/static .next/standalone/apps/gestao/.next/static && cp -r public .next/standalone/apps/gestao/public",
    "start": "HOSTNAME=0.0.0.0 node .next/standalone/apps/gestao/server.js",
    "lint": "eslint . --ignore-pattern .next --ignore-pattern node_modules"
  },
  "dependencies": {
    "@fsw/db": "*",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
