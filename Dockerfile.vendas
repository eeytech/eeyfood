FROM node:22-slim AS base

FROM base AS deps
WORKDIR /app
COPY package.json package-lock.json ./
COPY packages/db/package.json ./packages/db/
COPY apps/gestao/package.json ./apps/gestao/
COPY apps/vendas/package.json ./apps/vendas/
COPY apps/websocket/package.json ./apps/websocket/
RUN npm ci

FROM base AS builder
WORKDIR /app
COPY --from=deps /app/node_modules ./node_modules
COPY --from=deps /app/apps/vendas/node_modules ./apps/vendas/node_modules
COPY . .

ARG NEXT_PUBLIC_WEBSOCKET_URL

ENV NEXT_PUBLIC_WEBSOCKET_URL=$NEXT_PUBLIC_WEBSOCKET_URL
ENV NEXT_PRIVATE_WORKERS=1
ENV NODE_OPTIONS="--max-old-space-size=2048"

RUN npm run build -w @fsw/db && npm run build -w @fsw/vendas

FROM base AS runner
WORKDIR /standalone

ENV NODE_ENV=production
ENV HOSTNAME=0.0.0.0
ENV PORT=3020

COPY --from=builder /app/apps/vendas/.next/standalone ./
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/packages/db/drizzle ./packages/db/drizzle
COPY --from=builder /app/packages/db/dist ./packages/db/dist

EXPOSE 3020
CMD ["node", "apps/vendas/server.js"]
