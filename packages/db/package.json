{
  "name": "@fsw/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./modules-constants": {
      "types": "./dist/modules-constants.d.ts",
      "import": "./dist/modules-constants.js",
      "default": "./dist/modules-constants.js"
    },
    "./restaurant-utils": {
      "types": "./dist/restaurant-utils.d.ts",
      "import": "./dist/restaurant-utils.js",
      "default": "./dist/restaurant-utils.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js",
      "default": "./dist/types.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "npx tsx src/migrate.ts",
    "db:seed": "npx tsx src/seed.ts",
    "db:vacuum": "npx tsx src/vacuum.ts"
  },
  "dependencies": {
    "@types/bcryptjs": "^2.4.6",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.36.4",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.17",
    "@types/pg": "^8.11.11",
    "drizzle-kit": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3"
  }
}
